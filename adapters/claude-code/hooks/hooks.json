{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch-hook.sh", "args": ["SessionStart"], "timeout": 1.5 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch-hook.sh", "args": ["UserPromptSubmit"], "timeout": 1.5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch-hook.sh", "args": ["PreToolUse"], "timeout": 1.5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch-hook.sh", "args": ["PostToolUse"], "timeout": 1.5 }]
      }
    ]
  }
}
